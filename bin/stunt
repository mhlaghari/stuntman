#!/usr/bin/env bash
# stuntman worker — a pluggable stunt double.
#
# Verbs (what the /delegate skill calls):
#   stunt exec "<spec>"                 run the worker on a spec
#   stunt resume <session_id> "<text>"  send review feedback into the same worker session
#
# Both print one normalized JSON line: {"backend", "session_id", "result", "is_error"}
#
# Backends (STUNTMAN_WORKER):
#   claude    (default) headless Claude Code via a local Anthropic-compatible proxy
#             (free-claude-code on :8082) with an isolated CLAUDE_CONFIG_DIR
#   opencode  `opencode run` — talks to DeepSeek/Groq/Ollama/75+ providers natively,
#             no proxy needed (auth via `opencode auth login` or provider env keys)
#   codex     `codex exec` — OpenAI's Codex CLI, no proxy needed. Reuses the user's own
#             `codex login` (ChatGPT subscription or API key) directly — unlike the claude
#             backend, there's no separate identity to isolate, so it runs against the
#             normal ~/.codex config/session store (worker sessions land in the same
#             `codex resume` history as the user's own interactive sessions).
#   agy       `agy -p` — Google's Antigravity CLI, no proxy needed. Reuses the user's own
#             Antigravity login/subscription (models: Gemini 3.x, Claude Sonnet/Opus,
#             GPT-OSS — see `agy models`). Passes --add-dir "$PWD" because agy otherwise
#             works in its own scratch workspace (~/.gemini/antigravity-cli/scratch)
#             instead of the project directory.
#
# Env:
#   STUNTMAN_WORKER      claude | opencode | codex | agy     (default: claude)
#   STUNTMAN_MODEL       claude: id from the proxy's /v1/models; opencode: provider/model;
#                        codex: a model id accepted by `codex exec -m`;
#                        agy: an id from `agy models` (e.g. gemini-3.7-flash-high)
#   STUNTMAN_CONFIG_DIR  claude worker config dir      (default: ~/.claude-stuntman)
#   STUNTMAN_BASE_URL    claude fallback proxy URL     (default: http://localhost:8082)
#   STUNTMAN_AUTH_TOKEN  claude fallback proxy token   (default: freecc)
#
# Anything else (first arg starting with "-", or no args) passes straight through to
# the claude backend for manual/interactive use, e.g.:  stunt -p "task" --output-format json
set -e

BACKEND="${STUNTMAN_WORKER:-claude}"

claude_invoke() {
  export CLAUDE_CONFIG_DIR="${STUNTMAN_CONFIG_DIR:-$HOME/.claude-stuntman}"
  mkdir -p "$CLAUDE_CONFIG_DIR"
  if [ -n "${STUNTMAN_MODEL:-}" ]; then
    set -- --model "$STUNTMAN_MODEL" "$@"
  fi
  # Preferred: the free-claude-code launcher (injects proxy env, preflights the server).
  if command -v fcc-claude >/dev/null 2>&1; then
    fcc-claude "$@"
  else
    # Fallback: any Anthropic-compatible proxy via plain env vars.
    export ANTHROPIC_BASE_URL="${STUNTMAN_BASE_URL:-http://localhost:8082}"
    export ANTHROPIC_AUTH_TOKEN="${STUNTMAN_AUTH_TOKEN:-freecc}"
    unset ANTHROPIC_API_KEY
    export CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY=1
    claude "$@"
  fi
}

# claude -p --output-format json → single JSON object on the last line
normalize_claude() {
  python3 -c '
import json, sys
lines = [l for l in sys.stdin.read().splitlines() if l.strip()]
d = json.loads(lines[-1])
u = d.get("usage") or {}
print(json.dumps({"backend": "claude", "session_id": d.get("session_id"),
                  "result": d.get("result", ""), "is_error": bool(d.get("is_error")),
                  "usage": {"input_tokens": u.get("input_tokens", 0),
                            "output_tokens": u.get("output_tokens", 0),
                            "cache_read_tokens": u.get("cache_read_input_tokens", 0),
                            "cache_write_tokens": u.get("cache_creation_input_tokens", 0)},
                  "cost_usd": round(d.get("total_cost_usd") or 0, 6),
                  "duration_s": round((d.get("duration_ms") or 0) / 1000)}))
'
}

# opencode run --format json → JSONL event stream; result is the last text part,
# usage is summed across step-finish events
normalize_opencode() {
  python3 -c '
import json, sys
sid, texts, err = None, [], False
tin = tout = cread = cwrite = 0
cost = 0.0
for line in sys.stdin:
    line = line.strip()
    if not line.startswith("{"):
        continue
    try:
        d = json.loads(line)
    except ValueError:
        continue
    sid = d.get("sessionID") or sid
    part = d.get("part") or {}
    if part.get("type") == "text":
        texts.append(part.get("text", ""))
    if part.get("type") == "step-finish":
        t = part.get("tokens") or {}
        tin += t.get("input", 0); tout += t.get("output", 0) + t.get("reasoning", 0)
        c = t.get("cache") or {}
        cread += c.get("read", 0); cwrite += c.get("write", 0)
        cost += part.get("cost") or 0
    if d.get("type") == "error" or part.get("type") == "error":
        err = True
print(json.dumps({"backend": "opencode", "session_id": sid,
                  "result": texts[-1] if texts else "", "is_error": err,
                  "usage": {"input_tokens": tin, "output_tokens": tout,
                            "cache_read_tokens": cread, "cache_write_tokens": cwrite},
                  "cost_usd": round(cost, 6)}))
'
}

# codex exec --json → JSONL event stream (thread.started / item.completed / turn.completed);
# result is the LAST agent_message (codex emits a preamble message before doing work, then a
# final summary — the summary is what review should see). No cost field: Codex bills via the
# user's own ChatGPT subscription or API key, not a per-call metered rate like DeepSeek/opencode.
normalize_codex() {
  python3 -c '
import json, sys
tid, texts, done, err = None, [], False, False
tin = tout = cread = cwrite = 0
for line in sys.stdin:
    line = line.strip()
    if not line.startswith("{"):
        continue
    try:
        d = json.loads(line)
    except ValueError:
        continue
    t = d.get("type", "")
    if t == "thread.started":
        tid = d.get("thread_id") or tid
    elif t == "item.completed":
        item = d.get("item") or {}
        if item.get("type") == "agent_message":
            texts.append(item.get("text", ""))
    elif t == "turn.completed":
        done = True
        u = d.get("usage") or {}
        tin += u.get("input_tokens", 0)
        tout += u.get("output_tokens", 0) + u.get("reasoning_output_tokens", 0)
        cread += u.get("cached_input_tokens", 0)
        cwrite += u.get("cache_write_input_tokens", 0)
    elif t in ("turn.failed", "error"):
        err = True
print(json.dumps({"backend": "codex", "session_id": tid,
                  "result": texts[-1] if texts else "", "is_error": err or not done,
                  "usage": {"input_tokens": tin, "output_tokens": tout,
                            "cache_read_tokens": cread, "cache_write_tokens": cwrite},
                  "cost_usd": 0}))
'
}

# agy -p --output-format json → single JSON object on the last line
# {"conversation_id", "status", "response", "usage": {...}}. output_tokens already
# includes thinking_tokens (total_tokens = input + output), so no summing needed.
# No cost field: Antigravity bills via the user's own subscription, like codex.
normalize_agy() {
  python3 -c '
import json, sys
lines = [l for l in sys.stdin.read().splitlines() if l.strip().startswith("{")]
d = json.loads(lines[-1])
u = d.get("usage") or {}
print(json.dumps({"backend": "agy", "session_id": d.get("conversation_id"),
                  "result": d.get("response", ""),
                  "is_error": d.get("status") != "SUCCESS",
                  "usage": {"input_tokens": u.get("input_tokens", 0),
                            "output_tokens": u.get("output_tokens", 0),
                            "cache_read_tokens": u.get("cache_read_tokens", 0),
                            "cache_write_tokens": 0},
                  "cost_usd": 0}))
'
}

case "${1:-}" in
  exec)
    SPEC="${2:?usage: stunt exec \"<spec>\"}"
    if [ "$BACKEND" = "opencode" ]; then
      MODEL_ARGS=()
      [ -n "${STUNTMAN_MODEL:-}" ] && MODEL_ARGS=(--model "$STUNTMAN_MODEL")
      opencode run "$SPEC" "${MODEL_ARGS[@]}" --format json | normalize_opencode
    elif [ "$BACKEND" = "codex" ]; then
      MODEL_ARGS=()
      [ -n "${STUNTMAN_MODEL:-}" ] && MODEL_ARGS=(-m "$STUNTMAN_MODEL")
      codex exec --json --skip-git-repo-check -s workspace-write "${MODEL_ARGS[@]}" "$SPEC" < /dev/null | normalize_codex
    elif [ "$BACKEND" = "agy" ]; then
      MODEL_ARGS=()
      [ -n "${STUNTMAN_MODEL:-}" ] && MODEL_ARGS=(--model "$STUNTMAN_MODEL")
      # --add-dir keeps agy working in the project dir (not its own scratch workspace);
      # --print-timeout lifts the 5m default, which is too short for real coding tasks.
      agy -p "$SPEC" --output-format json --dangerously-skip-permissions \
        --add-dir "$PWD" --print-timeout 30m "${MODEL_ARGS[@]}" < /dev/null | normalize_agy
    else
      claude_invoke -p "$SPEC" --output-format json --dangerously-skip-permissions | normalize_claude
    fi
    ;;
  resume)
    SID="${2:?usage: stunt resume <session_id> \"<feedback>\"}"
    FEEDBACK="${3:?usage: stunt resume <session_id> \"<feedback>\"}"
    if [ "$BACKEND" = "opencode" ]; then
      MODEL_ARGS=()
      [ -n "${STUNTMAN_MODEL:-}" ] && MODEL_ARGS=(--model "$STUNTMAN_MODEL")
      opencode run "$FEEDBACK" --session "$SID" "${MODEL_ARGS[@]}" --format json | normalize_opencode
    elif [ "$BACKEND" = "codex" ]; then
      MODEL_ARGS=()
      [ -n "${STUNTMAN_MODEL:-}" ] && MODEL_ARGS=(-m "$STUNTMAN_MODEL")
      # resume has no -s/--sandbox flag — it inherits the sandbox mode the thread started with.
      codex exec resume "$SID" --json --skip-git-repo-check "${MODEL_ARGS[@]}" "$FEEDBACK" < /dev/null | normalize_codex
    elif [ "$BACKEND" = "agy" ]; then
      MODEL_ARGS=()
      [ -n "${STUNTMAN_MODEL:-}" ] && MODEL_ARGS=(--model "$STUNTMAN_MODEL")
      agy --conversation "$SID" -p "$FEEDBACK" --output-format json --dangerously-skip-permissions \
        --add-dir "$PWD" --print-timeout 30m "${MODEL_ARGS[@]}" < /dev/null | normalize_agy
    else
      claude_invoke -p --resume "$SID" "$FEEDBACK" --output-format json --dangerously-skip-permissions | normalize_claude
    fi
    ;;
  *)
    # Pass-through for manual/interactive use (claude backend only).
    claude_invoke "$@"
    ;;
esac
